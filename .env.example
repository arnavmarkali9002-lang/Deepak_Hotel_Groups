# Server Port (defaults to 3000)
PORT=3000

# Environment mode (production / development)
NODE_ENV=production

# Custom path for persistent database storage (useful for Render/Railway/Fly.io persistent volumes)
DATA_DIR=./data

# =========================================================================
# Supabase Cloud Database Configuration
# =========================================================================
# 1. Create a project at https://supabase.com
# 2. Run supabase_schema.sql in the Supabase SQL Editor
# 3. Copy your Project URL & Service Role Key (or Anon Key) below:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# =========================================================================
# Meta WhatsApp Cloud API (Optional for automated WhatsApp booking alerts)
# =========================================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
ADMIN_WHATSAPP_NUMBER=919851415415
ADMIN_BOOKING_PHONE=+919851415415
